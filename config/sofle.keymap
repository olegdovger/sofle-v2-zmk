#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define QWERTY 0
#define FUN 1
#define UPPER 2

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            label = "qwerty";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |     |     |     |                   |     |     |     |     |     |       |
            // |       |  Q  |  W  |  E  |  R  |  T  |                   |  Y  |  U  |  I  |  O  |  P  |       |
            // |       |  A  |  S  |  D  |  F  |  G  |                   |  H  |  J  |  K  |  L  |  ;  |       |
            // |  ESC  |  Z  |  X  |  C  |  V  |  B  |   `   |  |   \   |  N  |  M  |  ,  |  .  |  /  | ENTER |
            //               | TAB | GUI | SHFT| SPC | CTRL  |  | ALT   | BSPC| FUN |  -  |  '  |

            bindings = <
&none    &none    &none     &none     &none     &none                             &none     &none     &none     &none     &none     &none
&none    &kp Q    &kp W     &kp E     &kp R     &kp T                            &kp Y     &kp U     &kp I     &kp O     &kp P     &none
&none    &kp A    &kp S     &kp D     &kp F     &kp G                            &kp H     &kp J     &kp K     &kp L     &kp SEMI  &none
&kp ESC  &kp Z    &kp X     &kp C     &kp V     &kp B    &kp GRAVE    &kp BSLH   &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RET
                   &kp TAB  &kp LGUI  &kp LSHFT &kp SPACE &kp LCTRL   &kp LALT   &kp BSPC  &mo FUN   &kp MINUS &kp SQT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        fun_layer {
            label = "fun";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |     |     |                   |      |     |     |     |      |       |
            // |       |  !  |  @  |  UP  |  $  |  %  |                   | PGUP |  7  |  8  |  9  | BSPC |       |
            // |       |  (  |LEFT | DOWN |RIGHT|  )  |                   | PGDN |  4  |  5  |  6  |      |       |
            // | UPPER |  [  |  ]  |  #   |  {  |  }  |   ^   |  |   &   |  *  |  1  |  2  |  3  |  +   |       |
            //               | INS | GUI  | SHFT | DEL| CTRL  |  | ALT   | SPC |     |  .  |  0   |

            bindings = <
&none       &none     &none       &none     &none     &none                             &none     &none             &none   &none   &none        &none
&ext_power EP_TOG       &kp EXCL  &kp AT      &kp UP   &kp DLLR  &kp PRCNT                         &kp PG_UP &kp N7            &kp N8 &kp N9 &kp BSPC    &none
&none       &kp LPAR  &kp LEFT    &kp DOWN &kp RIGHT &kp RPAR                          &kp PG_DN &kp N4            &kp N5 &kp N6 &trans      &none
&tog UPPER  &kp LBKT  &kp RBKT    &kp HASH &kp LBRC  &kp RBRC &kp CARET    &kp AMPS    &kp STAR &kp N1    &kp N2 &kp N3 &kp PLUS &kp EQUAL
                       &kp INS    &kp LGUI &kp LSHFT &kp DEL  &kp LCTRL    &kp LALT    &kp SPACE &trans           &kp DOT &kp N0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        upper_layer {
            label = "upper";

            // ------------------------------------------------------------------------------------------------------------
            // |       |      |      |     |      |      |                   |      |     |     |     |      |       |
            // |       | INS  | HOME | UP  | END  | PGUP |                   |  UP  | F7  | F8  | F9  | F10  |       |
            // |       | DEL  | LEFT |DOWN |RIGHT | PGDN |                   | DOWN | F4  | F5  | F6  | F11  |       |
            // | QWERTY|      | VOL+ |     |      |      |       |  |       |      | F1  | F2  | F3  | F12  |       |
            //                | VOL- |      |      |     |       |  |       |     |QWERTY| PSCR| SLCK |

            bindings = <
&none       &none       &none        &none     &none      &none                             &none     &none   &none   &none   &none      &none
&none       &kp INS     &kp HOME     &kp UP   &kp END    &kp PG_UP                         &kp UP   &kp F7  &kp F8  &kp F9  &kp F10    &none
&none       &kp DEL     &kp LEFT     &kp DOWN &kp RIGHT  &kp PG_DN                         &kp DOWN &kp F4  &kp F5  &kp F6  &kp F11    &none
&to QWERTY  &none       &kp C_VOL_UP &none    &none      &trans   &trans       &trans      &none    &kp F1  &kp F2  &kp F3  &kp F12    &kp C_PLAY_PAUSE
                         &kp C_VOL_DN &trans  &trans     &trans   &trans       &trans      &trans   &to QWERTY &kp PSCRN &kp SLCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
